<%- include('../components/header.ejs') %>
<div class="container mt-5">
    <h3 class="text-center mb-4">Lista de Restaurantes</h3>
    <div class="restaurant-list">
        <% if (restaurants && restaurants.length > 0) { %>
            <div class="row">
                <% restaurants.forEach(restaurant => { %>
                    <div class="col-md-4 mb-4">
                        <div class="card shadow-sm">
                            <img src="<%= restaurant.logo %>" alt="<%= restaurant.name %>" class="card-img-top" style="max-height: 200px; object-fit: cover;">
                            <div class="card-body">
                                <h5 class="card-title text-center"><%= restaurant.name %></h5>
                                <div class="text-center">
                                    <a href="/restaurant/<%= restaurant.id %>" class="btn btn-info btn-sm">Ver Menú</a>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <p class="text-center">No hay restaurantes disponibles en este momento.</p>
        <% } %>
    </div>
</div>

    <%- include('../components/footer.ejs') %>