<%- include('../components/headerAdmin.ejs') %>
    <div class="container mt-5">
        <h3 class="text-center mb-4">Lista de Hamburguesas</h3>
        <div class="burguer-list">
            <% if (burguers && burguers.length> 0){ %>
                <div class="row">
                    <% burguers.forEach(burguer=> { %>
                        <div class="col-md-4 mb-4">
                            <div class="card shadow-sm">
                                <img src="<%= burguer.image %>" alt="<%= burguer.name %>" class="card-img-top"
                                    style="max-height: 200px; object-fit: cover;">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        <%= burguer.name %>
                                    </h5>
                                    <div class="card-text">
                                        <p class="card-text">Descripción: <%= burguer.description %></p>
                                        <p class="card-text">Precio: <%= burguer.price %>Bs.</p>

                                    </div>
                                    <div class="card-title">
                                        <p class="card-text">
                                            Calificación Total: 
                                            <%= burguer.dataValues.totalRating || 0 %>
                                        </p>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <a href="/admin/restaurant/<%= burguer.restaurants_id %>/burguer/edit/<%= burguer.id %>" class="btn btn-dark btn-sm ">Editar</a>

                                        <form method="post" action="/admin/restaurant/<%= burguer.restaurants_id %>/burguer/delete/<%= burguer.id %>" class="d-inline">
                                            <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                </div>
                <% }else { %>
                    <p class="text-center">No hay hamburguesas disponibles en este momento</p>
                    <% }%>
        </div>
    </div>

    <%- include('../../components/footer.ejs') %>