<%- include('../components/headerAdmin.ejs') %>
<div class="container mt-5">
    <form action="/admin/create" method="POST" enctype="multipart/form-data" class="mt-4">
        <div class="mb-3">
            <label for="name" class="form-label">Nombre del Restaurante</label>
            <input type="text" id="name" name="name" class="form-control" required>
        </div>

        <div class="mb-3">
            <label>Foto de Perfil</label>
            <input class="form-control" type="file" name="logo"  />
        </div>

        <div class="d-grid gap-2">
            <button type="submit" class="btn btn-primary">Crear Restaurante</button>
        </div>
    </form>
</div>

<%- include('../../components/footer.ejs') %>