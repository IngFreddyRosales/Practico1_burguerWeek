<%- include('../components/headerAdmin.ejs') %>
<div class="container mt-5">
    <form action="/admin/restaurant/edit/<%= restaurant.id  %>" method="POST" enctype="multipart/form-data" class="mt-4">
        <div class="mb-3">
            <label for="name" class="form-label">Nombre del Restaurante</label>
            <input type="text" id="name" name="name" class="form-control" placeholder="Nombre del restaurant" 
            value="<%= restaurant ? restaurant.name : '' %>"  required>
        </div>

        <div class="mb-3">
            <label>Foto de Perfil</label>
            <input class="form-control" id="foto"  type="file" name="logo" <%= restaurant ? '': 'required' %>>
        </div>

        <div class="d-grid gap-2">
            <button type="submit" class="btn btn-primary">Editar Restaurante</button>
        </div>
    </form>
</div>
<%- include('../../components/footer.ejs') %>